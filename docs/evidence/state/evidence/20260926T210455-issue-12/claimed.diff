--- a/app_test.py
+++ b/app_test.py
@@ -55,6 +55,19 @@ class PasteServiceTest(unittest.TestCase):
         self.assertEqual(status, 400)
         self.assertTrue(json.loads(body)["error"])
 
+    def test_delete_removes_paste_and_returns_no_content(self) -> None:
+        status, body = self.request("POST", "/paste", {"content": "delete me"})
+        self.assertEqual(status, 201)
+        paste_id = json.loads(body)["id"]
+
+        status, body = self.request("GET", f"/paste/{paste_id}")
+        self.assertEqual(status, 200)
+        self.assertEqual(json.loads(body), {"content": "delete me"})
+
+        status, body = self.request("DELETE", f"/paste/{paste_id}")
+        self.assertEqual(status, 204)
+        self.assertEqual(body, b"")
+
+        status, body = self.request("GET", f"/paste/{paste_id}")
+        self.assertEqual(status, 404)
+        self.assertEqual(json.loads(body), {"error": "not found"})
+
+    def test_delete_unknown_id_returns_not_found(self) -> None:
+        status, body = self.request("DELETE", "/paste/does-not-exist-123")
+        self.assertEqual(status, 404)
+        self.assertEqual(json.loads(body), {"error": "not found"})
+
     def test_unknown_id_returns_404(self) -> None:
         status, _ = self.request("GET", "/paste/does-not-exist-123")
         self.assertEqual(status, 404)
