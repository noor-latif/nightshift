+"""Tests for POST /paste handling of malformed Content-Length headers."""
+from __future__ import annotations
+
+import http.client
+import json
+import threading
+import unittest
+
+import app
+
+
+class ContentLengthHeaderTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.server = app.make_server(0)
+        self.port = self.server.server_address[1]
+        threading.Thread(target=self.server.serve_forever, daemon=True).start()
+        self.addCleanup(self.server.shutdown)
+        self.addCleanup(self.server.server_close)
+        self.host = "127.0.0.1"
+
+    def _connect(self) -> http.client.HTTPConnection:
+        conn = http.client.HTTPConnection(self.host, self.port, timeout=5)
+        self.addCleanup(conn.close)
+        return conn
+
+    def _post_with_header(self, body: bytes, value: str) -> http.client.HTTPResponse:
+        conn = self._connect()
+        conn.request("POST", "/paste", body=body, headers={"Content-Length": value})
+        return conn.getresponse()
+
+    def test_non_numeric_content_length_returns_400_json(self) -> None:
+        resp = self._post_with_header(b"x=1", "abc")
+        self.assertEqual(resp.status, 400)
+        self.assertEqual(resp.getheader("Content-Type"), "application/json")
+        payload = json.loads(resp.read())
+        self.assertEqual(set(payload), {"error"})
+        self.assertIsInstance(payload["error"], str)
+        self.assertTrue(payload["error"])
+        # server survives: a follow-up request still works
+        resp = self._post_with_header(b'{"content": "after"}', "16")
+        self.assertEqual(resp.status, 201)
+
+    def test_missing_content_length_keeps_invalid_json_behavior(self) -> None:
+        conn = self._connect()
+        conn.putrequest("POST", "/paste")
+        conn.endheaders(message_body=b"")  # no Content-Length header at all
+        resp = conn.getresponse()
+        self.assertEqual(resp.status, 400)
+        self.assertEqual(json.loads(resp.read()), {"error": "invalid JSON body"})
+
+    def test_correct_content_length_round_trips(self) -> None:
+        body = json.dumps({"content": "hello"}).encode("utf-8")
+        resp = self._post_with_header(body, str(len(body)))
+        self.assertEqual(resp.status, 201)
+        paste_id = json.loads(resp.read())["id"]
+        conn = self._connect()
+        conn.request("GET", f"/paste/{paste_id}")
+        resp = conn.getresponse()
+        self.assertEqual(resp.status, 200)
+        self.assertEqual(json.loads(resp.read()), {"content": "hello"})
+
+
+if __name__ == "__main__":
+    unittest.main()
```

