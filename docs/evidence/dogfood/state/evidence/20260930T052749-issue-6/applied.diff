+    def test_start_lap_error_releases_claim_for_next_tick(self):
+        import selector
+
+        gh = os.path.join(self.tmp, "gh")
+        with open(gh, "w") as f:
+            f.write("#!%s\\n" % sys.executable)
+            f.write(
+                "import sys\\n"
+                "if sys.argv[1] == 'issue':\\n"
+                "    print('[{\\\"number\\\": 18, \\\"createdAt\\\": \\\"2026-01-01T00:00:00Z\\\"}]')\\n"
+                "else:\\n"
+                "    print('[]')\\n"
+            )
+        os.chmod(gh, 0o755)
+        claims = os.path.join(self.tmp, "claims")
+        starts = []
+        deps = {
+            "state_path": os.path.join(self.tmp, "state.json"),
+            "claim": lambda now: selector.claim_next(
+                "r/x", issues_dir=claims, now=now, gh=gh),
+            "start_lap": lambda issue, lap: (_ for _ in ()).throw(
+                RuntimeError("spawn failed")),
+            "notify": lambda text: None,
+            "kill_lap": lambda lap: None,
+            "reconcile": lambda now: [],
+            "break_claim": lambda path, now: os.remove(path),
+        }
+        state = supervisor.load_state(deps["state_path"])
+        with unittest.mock.patch.object(supervisor, "RUNTIME_LOG_PATH",
+                                        os.path.join(self.tmp, "log.jsonl")):
+            with self.assertRaisesRegex(RuntimeError, "spawn failed"):
+                supervisor.tick(state, self.now, deps)
+            claim_path = os.path.join(claims, "issue-18.json")
+            self.assertFalse(os.path.exists(claim_path))
+            deps["start_lap"] = lambda issue, lap: starts.append(issue) or lap.update(pid=4242)
+            events = supervisor.tick(
+                supervisor.load_state(deps["state_path"]), self.now + 1, deps)
+        self.assertIn("dispatch:dispatched", events)
+        self.assertEqual(starts, [18])
+        with open(os.path.join(self.tmp, "log.jsonl")) as f:
+            rows = [json.loads(line) for line in f]
+        self.assertTrue(any(r["event"] == "intervention" for r in rows))
+
+
 
 if __name__ == "__main__":
     unittest.main()