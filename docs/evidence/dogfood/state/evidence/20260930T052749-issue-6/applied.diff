diff --git a/src/supervisor.py b/src/supervisor.py
index ad32e45..4fa2e3c 100644
--- a/src/supervisor.py
+++ b/src/supervisor.py
@@ -209,7 +209,21 @@ def dispatch(state, now, deps):
     # wallclock guard measures the current lap session, not all history:
     # refresh so a supervisor restarted hours later dispatches instead of HALT
     state["started_at"] = now
-    deps["start_lap"](claim["issue"], state["lap"])
+    try:
+        deps["start_lap"](claim["issue"], state["lap"])
+    except Exception as e:
+        # Dispatch did not complete, so do not leave the fresh claim blocking
+        # a retry for the full lap wall-clock limit. Keep the failure visible
+        # even though the tick-error path will also record its traceback.
+        state["lap"] = None
+        try:
+            os.remove(claim["path"])
+        except OSError:
+            pass
+        runtime_log("intervention", issue=claim["issue"],
+                    detail="dispatch failed after claim; claim released: %r" % e,
+                    claim=claim["path"])
+        raise
     runtime_log("dispatch", issue=claim["issue"], pid=state["lap"].get("pid"))
     save_state(state, deps["state_path"])
     return "dispatched"
