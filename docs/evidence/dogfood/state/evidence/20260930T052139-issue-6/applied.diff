+class TestTickErrorClaimRecovery(unittest.TestCase):
+    def test_failed_post_claim_dispatch_releases_claim_for_next_tick(self):
+        import selector
+
+        tmp = tempfile.mkdtemp()
+        gh = os.path.join(tmp, "gh")
+        with open(gh, "w") as f:
+            f.write("#!%s\n" % sys.executable)
+            f.write(
+                "import sys\\n"
+                "if sys.argv[1:3] == ['issue', 'list']:\\n"
+                "    print('[{\\\"number\\\": 18, \\\"createdAt\\\": \\\"2026-01-01T00:00:00Z\\\"}]')\\n"
+                "else:\\n"
+                "    print('[]')\\n"
+            )
+        os.chmod(gh, 0o755)
+        claims = os.path.join(tmp, "claims")
+        state_path = os.path.join(tmp, "state.json")
+        starts = []
+
+        def start_lap(issue, lap):
+            starts.append(issue)
+            if len(starts) == 1:
+                raise RuntimeError("spawn failed")
+            lap["pid"] = 4242
+
+        deps = {
+            "state_path": state_path,
+            "claim": lambda now: selector.claim_next(
+                "o/r", issues_dir=claims, now=now, gh=gh),
+            "start_lap": start_lap,
+            "kill_lap": lambda lap: None,
+            "notify": lambda text: None,
+            "reconcile": lambda now: [],
+            "break_claim": lambda path, now: os.remove(path),
+            "red_recheck": lambda issue: ("fail", None),
+        }
+        state = supervisor.load_state(state_path)
+        with unittest.mock.patch.object(
+                supervisor, "RUNTIME_LOG_PATH", os.path.join(tmp, "log.jsonl")):
+            with self.assertRaisesRegex(RuntimeError, "spawn failed"):
+                supervisor.tick(state, 1000.0, deps)
+            claim_path = os.path.join(claims, "issue-18.json")
+            self.assertFalse(os.path.exists(claim_path))
+            events = supervisor.tick(supervisor.load_state(state_path), 1005.0, deps)
+
+        self.assertIn("dispatch:dispatched", events)
+        self.assertEqual(starts, [18, 18])
+        with open(os.path.join(tmp, "log.jsonl")) as f:
+            rows = [json.loads(line) for line in f]
+        self.assertTrue(any(r["event"] == "intervention" and
+                            "released claim" in r["detail"] for r in rows))
+
+
