diff --git a/src/supervisor.py b/src/supervisor.py
index ad32e45..605ba1f 100644
--- a/src/supervisor.py
+++ b/src/supervisor.py
@@ -209,9 +209,27 @@ def dispatch(state, now, deps):
     # wallclock guard measures the current lap session, not all history:
     # refresh so a supervisor restarted hours later dispatches instead of HALT
     state["started_at"] = now
-    deps["start_lap"](claim["issue"], state["lap"])
-    runtime_log("dispatch", issue=claim["issue"], pid=state["lap"].get("pid"))
-    save_state(state, deps["state_path"])
+    try:
+        deps["start_lap"](claim["issue"], state["lap"])
+        runtime_log("dispatch", issue=claim["issue"], pid=state["lap"].get("pid"))
+        save_state(state, deps["state_path"])
+    except Exception as e:
+        # The claim was acquired before dispatch bookkeeping completed. Release
+        # it so a failed spawn or state write cannot block this issue for hours.
+        # If a child was started before the failure, stop it before retrying.
+        if state["lap"].get("pid"):
+            try:
+                deps["kill_lap"](state["lap"])
+            except Exception:
+                pass
+        state["lap"] = None
+        try:
+            os.remove(claim["path"])
+        except OSError:
+            pass
+        runtime_log("intervention", issue=claim["issue"],
+                    detail="dispatch failed; released claim %s: %r" % (claim["path"], e))
+        raise
     return "dispatched"
 
 
